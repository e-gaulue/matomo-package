# Build trees and per-package debhelper state.
debian/matomo
debian/matomo.debhelper.log
debian/matomo.substvars
debian/matomo.*.debhelper
debian/matomo-vanilla
debian/matomo-vanilla.debhelper.log
debian/matomo-vanilla.substvars
debian/matomo-vanilla.*.debhelper
debian/matomo-vanilla-logfile
debian/matomo-vanilla-logfile.debhelper.log
debian/matomo-vanilla-logfile.substvars
debian/matomo-vanilla-logfile.*.debhelper
