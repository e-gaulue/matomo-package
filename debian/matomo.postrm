#!/bin/sh
set -e

## Remove symlink previous created.

# The web server configuration is shared with matomo-vanilla, which replaces this
# package: /etc/matomo/apache.conf and lighttpd.conf are the same conffiles, enabled
# the same way. When matomo-vanilla is installed -- or being installed, which is the
# state this package is removed in -- that configuration is in service and must stay.
# Purging this package afterwards must not take the site down.
vanilla_present() {
	dpkg-query -W -f='${db:Status-Abbrev}' matomo-vanilla 2>/dev/null | grep -q '^i'
}

if { [ "$1" = "remove" ] || [ "$1" = "purge" ]; } && ! vanilla_present;
then

	if [ -L /etc/lighttpd/conf-available/50-matomo.conf ];
	then
		rm -f /etc/lighttpd/conf-available/50-matomo.conf
		invoke-rc.d lighttpd reload 3>/dev/null || true
	fi

	if [ -e /usr/share/apache2/apache2-maintscript-helper ];
	then
		. /usr/share/apache2/apache2-maintscript-helper
		apache2_invoke disconf matomo.conf || true
		rm -f /etc/apache2/conf-available/matomo.conf
	fi			
fi

#DEBHELPER#
