#!/bin/bash
#
# see http://www.fifi.org/doc/debconf-doc/tutorial.html
# see http://manpages.ubuntu.com/manpages/lucid/man7/debconf-devel.7.html

set -e
umask 022

# Source debconf library.
. /usr/share/debconf/confmodule
db_version 2.0 || { echo "$0: needs DebConf 2.0 or later"; exit 1; }

# db_beginblock

# import piwik preferences

db_get piwik/automatic-upgrade || true
if [ "$RET" = "true" ]; then
	# migrate the value
	db_set matomo/automatic-upgrade "$RET"

	# set the question as already seen
	db_fset matomo/automatic-upgrade seen true

	# reset to default value for piwik package because it's unused anyway
	db_reset piwik/automatic-upgrade

	echo "* Automatic database upgrade preference migrated from Piwik to Matomo"
fi

db_input high matomo/automatic-upgrade || true
db_go || true

# Serving Matomo at /matomo: asked on a fresh installation only, and never when an
# alias is already in service. An installed Matomo -- config.ini.php exists -- has a
# web server that already reaches it, whether through this alias, one the
# administrator uncommented in /etc/matomo/apache.conf, or a virtual host of their
# own; asking would describe a danger that does not apply, the web installer being
# long finished.
alias_active() {
	[ -e /etc/apache2/conf-enabled/matomo-alias.conf ] && return 0
	[ -e /etc/lighttpd/conf-enabled/50-matomo.conf ] && return 0
	if [ -f /etc/matomo/apache.conf ] \
	   && grep -qE '^[[:space:]]*Alias[[:space:]]+/(matomo|piwik)[[:space:]]' /etc/matomo/apache.conf; then
		return 0
	fi
	return 1
}
if [ ! -e /etc/matomo/config.ini.php ] && ! alias_active; then
	db_input high matomo-vanilla/webserver-alias || true
	db_go || true
fi

# ---------------------------------------------------------------------------
# Archiving: a timer now, a cron job before. Which of the two questions to ask
# depends on what is already running on this system, so it is decided here --
# the config script runs before anything is unpacked, which is the only moment
# the old cron file is still in place to be looked at.
# ---------------------------------------------------------------------------

# A cron job that actually archives: an uncommented line calling core:archive. The
# file this package used to ship had that line commented out, so its mere presence
# proves nothing. The .dpkg-bak is looked at too, for the case where dpkg has
# already withdrawn the conffile on an earlier, interrupted attempt.
archiving_cron_active() {
	for f in /etc/cron.d/matomo-archive /etc/cron.d/matomo-archive.dpkg-bak; do
		[ -f "$f" ] || continue
		if grep -qE '^[[:space:]]*[^#[:space:]].*core:archive' "$f"; then
			return 0
		fi
	done
	return 1
}

# Already enabled? Then there is nothing to decide, and asking would invite an
# answer that undoes the administrator's own.
#
# Read from the enablement symlink, not from deb-systemd-helper: that tool refuses
# to run outside a dpkg maintainer script -- "was not called from dpkg. Exiting." --
# and a config script is not one, so it answered "not enabled" every single time.
# The symlink is what enabling creates, under /etc, and it is readable by anyone.
# systemctl is no use either: a chroot has no running systemd, and a maintainer
# script is not allowed to call it.
timer_already_enabled() {
	if [ -L /etc/systemd/system/timers.target.wants/matomo.timer ]; then
		return 0
	fi
	for l in /etc/systemd/system/timers.target.wants/matomo@*.timer; do
		if [ -L "$l" ]; then
			return 0
		fi
	done
	return 1
}

# A timer drop-in written by the administrator means the schedule is theirs. Asking
# would invite an answer that quietly overrides it, so nothing is asked and nothing
# is touched. A drop-in on the SERVICE is not the same thing -- that is where an
# explicit --url goes, and this package tells people to put it there.
admin_timer_dropin() {
	for d in /etc/systemd/system/matomo.timer.d /etc/systemd/system/matomo@*.timer.d; do
		if [ -d "$d" ]; then
			for c in "$d"/*.conf; do
				if [ -f "$c" ]; then
					return 0
				fi
			done
		fi
	done
	return 1
}

if timer_already_enabled || admin_timer_dropin; then
	db_set matomo-vanilla/archiving-decision none || true
elif archiving_cron_active; then
	db_set matomo-vanilla/archiving-decision cron || true
	db_input high matomo-vanilla/archiving-keep-cron || true
	db_go || true
else
	db_set matomo-vanilla/archiving-decision timer || true
	db_input high matomo-vanilla/archiving-enable-timer || true
	db_go || true
fi

# db_endblock

exit 
