# Change/reset permission on /var/lib/matomo/data/tmp to www-data 0755/0644
matomo: recursive-privilege-change "chown -R" [postinst:*]
matomo: recursive-privilege-change "find /var/lib/matomo/data/tmp -type d -exec chmod" [postinst:*]
matomo: recursive-privilege-change "find /var/lib/matomo/data/tmp -type f -exec chmod" [postinst:*]

