# Upstream ships misc/log-analytics/import_logs.py with "#!/usr/bin/python", while
# its own README in the same directory states "Requirements: Python 3". The shebang
# is upstream's inconsistency, and Debian has had no /usr/bin/python since Debian 11.
#
# Overridden rather than corrected, which departs from this package's usual rule, so
# the reason belongs here. Correcting at the source only makes sense when the
# correction holds -- and this one cannot. This package tolerates Matomo's own
# updater: an administrator who enables it unpacks a fresh upstream release over
# /usr/share/matomo, and every edit we had made to an upstream file is silently
# reverted. Worse, the manifest entry we would have had to recompute for the edited
# file then describes a file that no longer exists in that form, so Matomo's
# integrity check starts reporting a discrepancy we created. An override is
# permanent and visible; an edit to an upstream file is temporary and says nothing
# when it vanishes.
#
# It also never mattered in practice. fixperms ships every file 0644, so the script
# is not executable here and its shebang is never consulted. Matomo itself never
# invokes it -- the sole mention in the PHP source is a comment. And the real-world
# invocation is explicit anyway; the maintainer's own logrotate snippet reads:
#     /usr/bin/python3 /usr/share/matomo/misc/log-analytics/import_logs.py --auth-config ...
# Verified working that way. python3 is a Recommends for exactly this purpose.
#
# This had been "corrected" with a sed for years, on a file that was never
# executable: the correction was cosmetic throughout.
matomo-vanilla: unusual-interpreter /usr/bin/python [usr/share/matomo/misc/log-analytics/import_logs.py]

# Matomo use it's own bug numbers
matomo-vanilla: improbable-bug-number-in-closes

# Matomo's caches, sessions and compiled templates live under /var/lib/matomo/tmp and
# are written by the web server, so the postinst has to set ownership there -- and it
# has to do it recursively, because files already created by a previous version are
# below it. dpkg-statoverride is checked first, so an administrator who has chosen
# their own ownership keeps it.
#
# The line number is deliberately NOT pinned. These overrides carried [postinst:20]
# and friends, and the three commands moved to lines 31-33 the first time the script
# was edited -- which turns a working override into a mismatched-override warning
# plus the original tag, twice the noise for no reason. Same lesson as the
# spelling-error-in-changelog override below: context that drifts is worse than no
# context. The file is still named, so this cannot silence a recursive chown added
# somewhere else.
matomo-vanilla: recursive-privilege-change "chown -R" [postinst:*]
matomo-vanilla: recursive-privilege-change "find /var/lib/matomo/tmp -type d -exec chmod" [postinst:*]
matomo-vanilla: recursive-privilege-change "find /var/lib/matomo/tmp -type f -exec chmod" [postinst:*]

# Rules added specifically for 4.1.0
matomo-vanilla: script-not-executable [usr/share/matomo/vendor/wikimedia/less.php/bin/lessc]
# Rules added for version 5.x 
matomo-vanilla: script-not-executable [usr/share/matomo/vendor/symfony/error-handler/Resources/bin/extract-tentative-return-types.php]
matomo-vanilla: script-not-executable [usr/share/matomo/vendor/symfony/error-handler/Resources/bin/patch-type-declarations]
matomo-vanilla: script-not-executable [usr/share/matomo/vendor/symfony/var-dumper/Resources/bin/var-dump-server]


